#: helios/tasks.py:119
msgid "encrypted tally computed"
msgstr "escrutinio cifrado calculado"

#: helios/tasks.py:121
#, python-format
msgid ""
"The encrypted tally for election %(election_name)s has been computed.\n"
"\n"
"--\n"
"Helios"
msgstr ""
"Calculouse o escrutinio cifrado da elección %(election_name)s.\n"
"\n"
"--\n"
"Helios"

#: helios/tasks.py:136
msgid "Helios Decrypt"
msgstr "Descifrado de Helios"

#: helios/tasks.py:138
#, python-format
msgid ""
"Helios has decrypted its portion of the tally for election %(election_name)s.\n"
"\n"
"--\n"
"Helios"
