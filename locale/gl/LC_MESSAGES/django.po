"Helios descifrou a súa parte do escrutinio da elección %(election_name)s.\n"
"\n"
"--\n"
"Helios"

#: helios/tasks.py:149
#, python-format
msgid ""
"Your voter file upload for election %(election_name)s has been processed.\n"
"\n"
"%(count)s voter has been created.\n"
"\n"
"--\n"
"Helios"
