"Non se puido engadir a seguinte persoa votante á elección \"%(election_name)s\" porque se deu de baixa dos correos de"
" Helios:\n"
"\n"
msgstr[1] ""
"Non se puideron engadir as seguintes %(count)s persoas votantes á elección \"%(election_name)s\" porque se deron de "
"baixa dos correos de Helios:\n"
"\n"

#: helios/tasks.py:190
#, python-format
msgid "- %(name)s (%(email)s) [ID: %(voter_id)s, Type: %(voter_type)s]\n"
msgstr "- %(name)s (%(email)s) [ID: %(voter_id)s, tipo: %(voter_type)s]\n"

#: helios/tasks.py:202
#, python-format
msgid ""
"\n"
"This voter will need to opt back in before they can be added to elections.\n"
"They can opt back in at: %(optin_url)s\n"
"\n"
"--\n"
"Helios"
