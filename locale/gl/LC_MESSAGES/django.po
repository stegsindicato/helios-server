"Procesouse o ficheiro de votantes que subiches para a elección %(election_name)s.\n"
"\n"
"Creáronse %(count)s votantes.\n"
"\n"
"--\n"
"Helios"

#: helios/tasks.py:160
msgid "voter file processed"
msgstr "ficheiro de votantes procesado"

#: helios/tasks.py:172
#, python-format
msgid "Opted-out voters not added to election %(election_name)s"
msgstr "Votantes dados de baixa dos correos que non se engadiron á elección %(election_name)s"

#: helios/tasks.py:178
#, python-format
msgid ""
"The following voter could not be added to election \"%(election_name)s\" because they have opted out of receiving "
"Helios emails:\n"
"\n"
msgid_plural ""
"The following %(count)s voters could not be added to election \"%(election_name)s\" because they have opted out of "
"receiving Helios emails:\n"
"\n"
