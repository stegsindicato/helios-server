msgstr "Identificación para votar"

#: helios_auth/templates/edu_email/login.html
#, python-format
msgid "To participate, you need to prove that you have access to an <strong>@%(domain)s</strong> account."
msgstr "Para participar, necesitas demostrar que tes acceso a unha conta <strong>@%(domain)s</strong>."

#: helios_auth/templates/edu_email/login.html
msgid "We will send a six-digit code to your email. Your identity is used to ensure one voter per person; it is not published or included in the ballot contents."
msgstr "Enviaremos un código de seis cifras ao teu correo. A túa identidade úsase para garantir unha única persoa votante; non se publica nin se incorpora ao contido da papeleta."

